TPI_HOSTNAME=turingpi.local
TPI_USERNAME=root
# TPI_PASSWORD=   # optional: set to skip interactive login prompt
# Generate with `openssl passwd -6` or `mkpasswd -m sha-512`; double each $ as $$ for Make.
# PASSWORD_HASH=
SSH_KEY=~/.ssh/id_ed25519
# Public key baked into butane templates via @@SSH_PUBKEY@@ substitution.
# Defaults to $(HOME)/.ssh/id_ed25519.pub in the Makefile.
# SSH_PUBKEY=~/.ssh/id_ed25519.pub
